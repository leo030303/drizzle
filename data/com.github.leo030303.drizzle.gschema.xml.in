<?xml version="1.0" encoding="utf-8"?>
<schemalist>
  <schema path="/com/github/leo030303/drizzle/" id="@app-id@" gettext-domain="@gettext-package@">
    <key name="window-width" type="i">
      <default>600</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>400</default>
      <summary>Window height</summary>
    </key>
    <key name="is-maximized" type="b">
      <default>false</default>
      <summary>Window maximized state</summary>
    </key>
    <key name="recent-cities" type="as">
      <default>[]</default>
      <summary>JSON objects of GeoResponses for recent cities</summary>
    </key>
    <key name="recommendation-timespan" type="s">
      <default>"FourHour"</default>
      <summary>The timespan to display recommendations for</summary>
    </key>
  </schema>
</schemalist>
